generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  MOVIE
  TV
}

enum WatchStatus {
  PENDING
  SEARCHING
  DOWNLOADING
  DOWNLOADED
  FAILED
}

/// A setting edited from the admin page. One row per key that was actually changed:
/// everything else falls through to the `default` in the settings registry, so the table
/// stays a list of deliberate decisions rather than a copy of the whole config.
///
/// The value is text whatever the setting is — the registry in `settings.ts` knows how
/// to read it.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// The app's own log. It runs unattended, so the interesting things happen when nobody
/// is looking: what it grabbed at three in the morning, which release it threw away and
/// why, and which setting was changed just before it all stopped working. `docker logs`
/// has all of that too, but only for whoever can reach a shell, and only until the
/// container is recreated.
///
/// `source` is the module the line came from (`scheduler`, `download`, `settings`, …),
/// which is what the admin page filters on. `message` is the whole story in one line and
/// `detail` carries the specifics — a release name, an error, an old and a new value.
/// Never a secret: `writeLog` scrubs api keys out of both.
model LogEntry {
  id      Int      @id @default(autoincrement())
  at      DateTime @default(now())
  level   LogLevel
  source  String
  message String
  detail  String?

  // the only query that is not by id: dropping everything older than the retention
  @@index([at])
}

enum LibraryStatus {
  DOWNLOADING
  AVAILABLE
}

/// One download: one torrent and everything it brought. The watchlist is what is
/// still to be found, this is what is on disk or on its way there — the moment a
/// download starts, the units it covers leave the watchlist and a row appears here.
model Library {
  id     Int         @id @default(autoincrement())
  tmdbId Int
  type   ContentType

  /// What the indexer offered, which is also what qBittorrent named the torrent.
  /// Empty only in the window between the grab and the first read back.
  releaseTitle String  @default("")
  torrentHash  String?

  status LibraryStatus @default(DOWNLOADING)

  /// Whether what this download replaced was being watched. Once a season's last
  /// unit is carried off by a download, this is the only record left that the season
  /// was wanted — and that is what decides whether its next episode is picked up.
  watched Boolean @default(false)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// Until when it may not be deleted. Set when the download finishes; the torrent
  /// keeps seeding past it, this only unlocks the delete button.
  seedUntil DateTime?

  /// Asked for while it was still seeding. The cleanup carries it out the moment
  /// `seedUntil` passes.
  deleteRequested Boolean @default(false)
  deleteFiles     Boolean @default(true)

  /// Deleted, but remembered. Without the row the scanner would have no idea the
  /// episode was ever obtained and would fetch it all over again.
  removedAt DateTime?

  /// What this download covers, as `season:episode` keys — empty for a film, one
  /// entry for a single episode, all of them for a season pack, across seasons when
  /// the pack spans several. Every reader of this asks it about one title and wants
  /// exactly this set, so a child table would only be a set to rebuild on each read.
  episodes String[]

  @@index([tmdbId, type])
  @@index([torrentHash])
  @@index([status])
}

enum BlockReason {
  STALLED
  BAD_PAYLOAD
}

/// A release that was grabbed once and had to be thrown away. Kept by its normalized
/// name, which is what qBittorrent names the torrent after — that is what lets a later
/// search recognise it.
///
/// This used to live in memory for the lifetime of the process, which meant every
/// restart handed the same fake release another chance. A stall can be bad luck
/// though — no seeders that evening — so those expire; a payload that was not the
/// release at all never becomes one, and those have no expiry.
model BlockedRelease {
  id        Int         @id @default(autoincrement())
  title     String      @unique
  reason    BlockReason
  // what was actually wrong, kept for the log and for a later "why not this one?" view
  detail    String?
  blockedAt DateTime    @default(now())
  expiresAt DateTime?

  @@index([expiresAt])
}

// Identity only — titles and images always come from TMDB, everything else lives on
// the units.
model Watchlist {
  id        Int         @id @default(autoincrement())
  tmdbId    Int
  type      ContentType @default(MOVIE)
  addedAt   DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  /// Whether a season the show has not had yet is followed when it turns up. Since
  /// only what is watched has units, "no rows for season 4" cannot tell apart a
  /// season that was never announced from one that was not picked — so the whole
  /// show intent is stored instead of guessed. True is "watch this show", false is
  /// "watch these seasons".
  monitorNewSeasons Boolean @default(false)

  units WatchlistUnit[]

  @@unique([tmdbId, type])
}

/// One thing that can be searched for and downloaded: a movie is a single unit, a
/// show has one per episode. Keeping both in one table is what lets the scanner,
/// the download sync and the status aggregation share a single code path.
model WatchlistUnit {
  id          Int       @id @default(autoincrement())
  watchlistId Int
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  // both null on a movie, which is the single unit of its item — that one is kept
  // unique by ensureMovieUnit, a null never collides in a unique index
  seasonNumber  Int?
  episodeNumber Int?
  // the scanner decides from this whether it is worth searching yet
  airDate       DateTime?

  // a season is monitored when its units are; a new episode inherits the flag from
  // the season it belongs to (see inheritedMonitored)
  monitored Boolean @default(true)

  status         WatchStatus @default(PENDING)
  torrentHash    String?
  searchAttempts Int         @default(0)
  lastCheckedAt  DateTime?

  @@unique([watchlistId, seasonNumber, episodeNumber])
  @@index([status])
}
