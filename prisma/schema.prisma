generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  MOVIE
  TV
}

enum WatchStatus {
  PENDING
  SEARCHING
  DOWNLOADING
  DOWNLOADED
  FAILED
}

enum UserRole {
  ADMIN
  USER
}

/// Somebody who may use this install. The watchlist and the library are shared — one
/// household, one list — so a user is not an owner of anything here; the role only
/// decides who may change how the app behaves and who may destroy files.
///
/// An account can sign in two ways and does not have to have both: `passwordHash` is
/// null for one that only ever arrives through the identity provider, and
/// `oidcSubject` is null for a local one. The provider's `sub` is what links them,
/// not the address — an email can be reassigned to another person, `sub` cannot.
model User {
  id    Int      @id @default(autoincrement())
  /// stored lowercased, because it is also how an OIDC login finds an existing account
  email String   @unique
  /// Required, with no default: every line in the log that names somebody names this,
  /// and "who deleted this" answered with an email address reads like a machine did it.
  /// An account that arrives through the provider without one takes the local part of
  /// its address rather than being refused.
  name  String
  role  UserRole @default(USER)

  passwordHash String?
  oidcSubject  String? @unique

  /// Kept rather than deleted: the sessions go, the account stays refusable and the
  /// address stays taken, so a disabled user cannot sign straight back in through the
  /// provider and be auto-created as a new one.
  disabled Boolean @default(false)

  /// Where this person's own notifications go: any URL the app can call. With a
  /// placeholder in it (`{message}`) it is fetched with the text substituted in,
  /// which is what Telegram's `sendMessage` wants; without one it is posted to as
  /// JSON, which is what a Discord webhook wants. The install has a Telegram chat of
  /// its own in the settings — that one hears about everything, this one only about
  /// what its owner asked for.
  webhookUrl   String?
  notifyEvents String  @default("ready")

  /// The language rules belong to the person, not to the install: two people who want
  /// the same film in different languages get two downloads, two library rows and two
  /// separate lives for them from there on.
  ///
  /// `preferredLanguages` is ordered and its **first entry is the primary** — the only
  /// one the scanner will ever grab on its own. The rest is what may be offered when a
  /// download is started by hand, and taking one of those is a question the person has
  /// to answer, not something that happens quietly.
  preferredLanguages String  @default("hun,eng")
  excludeLanguages   String  @default("")
  /// what a release with no language tag at all is taken to be
  defaultLanguage    String  @default("eng")
  /// On by default: a 720p release in the right language beats a 1080p one in the wrong
  /// one. There is no weight beside it — the language either wins or it does not, and a
  /// number in between could only be set too low to matter.
  languageFirst      Boolean @default(true)

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  sessions   Session[]
  watchlists Watchlist[]
}

/// A signed in browser. The cookie carries a random token, this table holds its
/// SHA-256 — a database that leaks is then not a set of usable sessions, and there is
/// nothing to sign with, so no secret has to be kept anywhere.
model Session {
  /// the hash of the token, never the token
  id     String @id
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

/// A setting edited from the admin page. One row per key that was actually changed:
/// everything else falls through to the `default` in the settings registry, so the table
/// stays a list of deliberate decisions rather than a copy of the whole config.
///
/// The value is text whatever the setting is — the registry in `settings.ts` knows how
/// to read it.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// The app's own log. It runs unattended, so the interesting things happen when nobody
/// is looking: what it grabbed at three in the morning, which release it threw away and
/// why, and which setting was changed just before it all stopped working. `docker logs`
/// has all of that too, but only for whoever can reach a shell, and only until the
/// container is recreated.
///
/// `source` is the module the line came from (`scheduler`, `download`, `settings`, …),
/// which is what the admin page filters on. `message` is the whole story in one line and
/// `detail` carries the specifics — a release name, an error, an old and a new value.
/// Never a secret: `writeLog` scrubs api keys out of both.
model LogEntry {
  id      Int      @id @default(autoincrement())
  at      DateTime @default(now())
  level   LogLevel
  source  String
  message String
  detail  String?

  // the only query that is not by id: dropping everything older than the retention
  @@index([at])
}

enum LibraryStatus {
  DOWNLOADING
  AVAILABLE
}

/// One download: one torrent and everything it brought. The watchlist is what is
/// still to be found, this is what is on disk or on its way there — the moment a
/// download starts, the units it covers leave the watchlist and a row appears here.
model Library {
  id     Int         @id @default(autoincrement())
  tmdbId Int
  type   ContentType

  /// What the indexer offered, which is also what qBittorrent named the torrent.
  /// Empty only in the window between the grab and the first read back.
  releaseTitle String  @default("")
  torrentHash  String?

  /// Which edition this is. A download answers the people whose primary language it
  /// was fetched for, and nobody else: the same film wanted in Hungarian and in
  /// English is two rows here, two torrents and two things to delete.
  ///
  /// Empty means a row from before this existed. Unknown counts for everybody, so an
  /// install that upgrades does not fetch its whole library a second time.
  language String @default("")

  status LibraryStatus @default(DOWNLOADING)

  /// Who was watching what this download carried off. Once a season's last unit is
  /// taken by a download, this is the only record left that the season was wanted —
  /// and that is what decides, per person, whether its next episode is picked up.
  ///
  /// It is also the notification list: these are the people who asked for this, so
  /// these are the ones told when it is ready.
  watchedBy Int[]

  /// How big the torrent is, in bytes. Read back from the client rather than taken
  /// from the indexer, so it is what actually landed — and kept here because the
  /// listing has to be able to say it after the torrent is gone from qBittorrent.
  ///
  /// A double, not an Int: a season pack passes 2 GB routinely, and a byte count is
  /// exact in a double up to 2^53, which is nine petabytes past anything here.
  sizeBytes Float?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// Until when it may not be deleted, and nothing more: the torrent goes on seeding past
  /// it under the client's own rules, this only unlocks the delete button.
  ///
  /// A projection of qBittorrent's `seeding_time`, refreshed on every sync round rather
  /// than set once when the download landed — so a paused torrent keeps owing the time it
  /// is not spending, and one that was already complete before the app saw it is not asked
  /// to serve its window twice. See `syncSeedWindow`.
  seedUntil DateTime?

  /// Asked for while it was still seeding. The cleanup carries it out the moment
  /// `seedUntil` passes.
  deleteRequested Boolean @default(false)
  deleteFiles     Boolean @default(true)

  /// Who asked for it. The deletion itself happens later, in a background round with
  /// nobody signed in, and the notification about it still has to be able to say
  /// whose decision it was. Null on a row nobody marked, and on a deletion the
  /// retention time carried out on its own.
  deleteRequestedBy Int?

  /// Deleted, but remembered. Without the row the scanner would have no idea the
  /// episode was ever obtained and would fetch it all over again.
  removedAt DateTime?

  /// What this download covers, as `season:episode` keys — empty for a film, one
  /// entry for a single episode, all of them for a season pack, across seasons when
  /// the pack spans several. Every reader of this asks it about one title and wants
  /// exactly this set, so a child table would only be a set to rebuild on each read.
  episodes String[]

  @@index([tmdbId, type])
  @@index([torrentHash])
  @@index([status])
}

enum BlockReason {
  STALLED
  BAD_PAYLOAD
}

/// A release that was grabbed once and had to be thrown away. Kept by its normalized
/// name, which is what qBittorrent names the torrent after — that is what lets a later
/// search recognise it.
///
/// This used to live in memory for the lifetime of the process, which meant every
/// restart handed the same fake release another chance. A stall can be bad luck
/// though — no seeders that evening — so those expire; a payload that was not the
/// release at all never becomes one, and those have no expiry.
model BlockedRelease {
  id        Int         @id @default(autoincrement())
  title     String      @unique
  reason    BlockReason
  // what was actually wrong, kept for the log and for a later "why not this one?" view
  detail    String?
  blockedAt DateTime    @default(now())
  expiresAt DateTime?

  @@index([expiresAt])
}

/// Identity only — titles and images always come from TMDB, everything else lives on
/// the units.
///
/// **One row per person per title.** The same film wanted by three people is three
/// rows, and that is the point: nobody can take a title off somebody else's list.
/// What it costs is that "is this being watched" is never a single row's answer —
/// every write that acts on a title (a download starting, a release turning out to be
/// fake) has to act on **all** the rows for it, across everybody. The library is the
/// opposite and stays shared: there is one file on the disk however many people were
/// waiting for it.
model Watchlist {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tmdbId    Int
  type      ContentType @default(MOVIE)
  addedAt   DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  /// Whether a season the show has not had yet is followed when it turns up. Since
  /// only what is watched has units, "no rows for season 4" cannot tell apart a
  /// season that was never announced from one that was not picked — so the whole
  /// show intent is stored instead of guessed. True is "watch this show", false is
  /// "watch these seasons".
  monitorNewSeasons Boolean @default(false)

  units WatchlistUnit[]

  @@unique([userId, tmdbId, type])
  // every write that acts on a title has to find it on everybody's list
  @@index([tmdbId, type])
}

/// One thing that can be searched for and downloaded: a movie is a single unit, a
/// show has one per episode. Keeping both in one table is what lets the scanner,
/// the download sync and the status aggregation share a single code path.
model WatchlistUnit {
  id          Int       @id @default(autoincrement())
  watchlistId Int
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  // both null on a movie, which is the single unit of its item — that one is kept
  // unique by ensureMovieUnit, a null never collides in a unique index
  seasonNumber  Int?
  episodeNumber Int?
  // the scanner decides from this whether it is worth searching yet
  airDate       DateTime?

  // a season is monitored when its units are; a new episode inherits the flag from
  // the season it belongs to (see inheritedMonitored)
  monitored Boolean @default(true)

  status         WatchStatus @default(PENDING)
  torrentHash    String?
  searchAttempts Int         @default(0)
  lastCheckedAt  DateTime?

  @@unique([watchlistId, seasonNumber, episodeNumber])
  @@index([status])
}
