generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  MOVIE
  TV
}

enum WatchStatus {
  PENDING
  SEARCHING
  DOWNLOADING
  DOWNLOADED
  FAILED
}

enum BlockReason {
  STALLED
  BAD_PAYLOAD
}

/// A release that was grabbed once and had to be thrown away. Kept by its normalized
/// name, which is what qBittorrent names the torrent after — that is what lets a later
/// search recognise it.
///
/// This used to live in memory for the lifetime of the process, which meant every
/// restart handed the same fake release another chance. A stall can be bad luck
/// though — no seeders that evening — so those expire; a payload that was not the
/// release at all never becomes one, and those have no expiry.
model BlockedRelease {
  id        Int         @id @default(autoincrement())
  title     String      @unique
  reason    BlockReason
  // what was actually wrong, kept for the log and for a later "why not this one?" view
  detail    String?
  blockedAt DateTime    @default(now())
  expiresAt DateTime?

  @@index([expiresAt])
}

// Identity only — titles and images always come from TMDB, everything else lives on
// the units.
model Watchlist {
  id        Int         @id @default(autoincrement())
  tmdbId    Int
  type      ContentType @default(MOVIE)
  addedAt   DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  units WatchlistUnit[]

  @@unique([tmdbId, type])
}

/// One thing that can be searched for and downloaded: a movie is a single unit, a
/// show has one per episode. Keeping both in one table is what lets the scanner,
/// the download sync and the status aggregation share a single code path.
model WatchlistUnit {
  id          Int       @id @default(autoincrement())
  watchlistId Int
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  // both null on a movie, which is the single unit of its item — that one is kept
  // unique by ensureMovieUnit, a null never collides in a unique index
  seasonNumber  Int?
  episodeNumber Int?
  // the scanner decides from this whether it is worth searching yet
  airDate       DateTime?

  // a season is monitored when its units are; a new episode inherits the flag from
  // the season it belongs to (see inheritedMonitored)
  monitored Boolean @default(true)

  status         WatchStatus @default(PENDING)
  torrentHash    String?
  searchAttempts Int         @default(0)
  lastCheckedAt  DateTime?

  @@unique([watchlistId, seasonNumber, episodeNumber])
  @@index([status])
}
