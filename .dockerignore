# What the build context does not need. The two big ones are node_modules and .next: both
# are rebuilt inside the image, and sending a host copy of them over would be slower than
# the build itself — and on a different platform, wrong.
node_modules
.next
out
build

.git
.gitignore
.gitattributes
.github

# secrets and local state
.env
.env.local
.claude

# regenerated by `prisma generate` during the build
prisma/generated

# development only
.docker/docker-compose.yml
docker-compose.yml
PLAN.md
*.tsbuildinfo
.verify-*.ts
