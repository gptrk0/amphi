# Copy to .env and fill in. The .env is gitignored, this file is not — keep it free of secrets.

# APP
APP_ENV=development
APP_PORT=3000

# DATABASE
DATABASE_HOST=aioseerr_db
DATABASE_PORT=5432
DATABASE_USER=aioseerr
DATABASE_PASS=
DATABASE_NAME=aioseerr
DATABASE_URL="postgresql://${DATABASE_USER}:${DATABASE_PASS}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=public"

# TMDB
TMDB_API_KEY=
# optional, default en-US — release names use the original title either way
TMDB_LANGUAGE=en-US
# the age rating on a detail page is per country, optional, defaults to the
# region of TMDB_LANGUAGE (en-US -> US). HU gives the hungarian rating
TMDB_REGION=
# optional, default 720
TMDB_CACHE_TTL_MINUTES=720
# discover rows move faster than metadata, optional, default 60
DISCOVER_CACHE_TTL_MINUTES=60

# QBITTORRENT
TORRENT_URL=http://qbittorrent:8080
TORRENT_USER=
TORRENT_PASS=
# optional, default aioseerr — every torrent goes into this category
TORRENT_CATEGORY=aioseerr
# optional save paths, as qBittorrent sees them. empty leaves the destination to
# the category, filled in keeps films and shows in separate folders
TORRENT_MOVIE_PATH=
TORRENT_SERIES_PATH=

# JACKETT — the order is the priority, the first one wins on equal resolution
INDEXER_URL=http://jackett:9117
INDEXER_API_KEY=
# "all" uses the aggregate endpoint, which silently drops indexers that cannot do
# an imdbid search — list the indexer ids instead
INDEXER_IDS=all
# optional, overrides the INDEXER_IDS order
INDEXER_PRIORITY=
INDEXER_PRIORITY_BONUS=100000
# optional, default 360
INDEXER_CAPS_TTL_MINUTES=360

# SCHEDULER
WATCHLIST_SCAN_INTERVAL_MINUTES=15
# reading the client back is one local request, so it runs on its own, shorter
# interval — this is how fast a finished download is noticed
DOWNLOAD_SYNC_INTERVAL_MINUTES=1
# the wait after a fruitless search, doubling every time up to the cap. nothing is
# ever given up on, a release that is not out yet may still show up in a month
SEARCH_BACKOFF_MINUTES=30
SEARCH_MAX_BACKOFF_HOURS=24
EPISODE_SEARCH_CONCURRENCY=3
# a download that has not moved for this long is given up on: the torrent goes,
# the release is not picked again, and the search starts over
STALL_MINUTES=60
# 0 = keep the half downloaded files when a stalled torrent is dropped
STALL_DELETE_FILES=1
# a torrent whose biggest file is an executable, or that holds no video at all, is
# not what its name claims — it is dropped while it downloads.
# These lists have no built in fallback: an unset one means that rule is OFF, and `*`
# means accept everything. Leading dots are fine and the case does not matter.
# .r00-.r99 follow `rar` in the archive list; an archived release is never called bad,
# because its file list says nothing either way.
PAYLOAD_VIDEO_EXTENSIONS=mkv,mp4,avi,m4v,mpg,mpeg,ts,m2ts,mts,wmv,mov,flv,webm,vob,ogm,divx,iso,img
PAYLOAD_ARCHIVE_EXTENSIONS=rar,zip,7z,tar,gz,bz2,001
PAYLOAD_EXECUTABLE_EXTENSIONS=exe,scr,msi,bat,cmd,com,apk,lnk,vbs,js,jse,wsf,ps1,jar,dmg,pkg,deb,reg,hta,pif
# 0 = keep those files instead of deleting them with the torrent
PAYLOAD_DELETE_FILES=1
# 1 = only log what it would grab, nothing is added to qBittorrent
SCAN_DRY_RUN=1
# 1 = the background scanner does not start at all
SCAN_DISABLED=0

# DOWNLOAD DIALOG
# how many releases the dialog offers to choose from, best first
DOWNLOAD_OPTION_COUNT=5
# how long the search behind an open dialog is kept, so answering it does not
# search again
DOWNLOAD_PLAN_TTL_MINUTES=15

# QUALITY PROFILE
# selection order: resolution -> language -> indexer -> seeders -> codec
QUALITY_RESOLUTIONS=1080p,720p,2160p
QUALITY_PREFERRED_CODECS=x264,h264,avc
QUALITY_CODEC_BONUS=500
QUALITY_MIN_SEEDERS=1
# 0 = no upper limit
QUALITY_MAX_SIZE_GB=0
# ceiling for a season pack, per episode it contains (0 = no limit). a fully aired
# season is grabbed as one pack, and without this a 200GB remux would qualify
QUALITY_MAX_PACK_SIZE_PER_EPISODE_GB=5
# fake release guard: minimum size per claimed resolution
QUALITY_MIN_SIZE_MOVIE=2160p:8,1080p:2,720p:0.8,480p:0.3
QUALITY_MIN_SIZE_EPISODE=2160p:1.5,1080p:0.4,720p:0.15,480p:0.05
# excluded keywords, defaults to cam/ts/screener/exe and the like
QUALITY_EXCLUDE=
# language: first one wins, an untagged release counts as QUALITY_DEFAULT_LANGUAGE.
# The excluded list never applies to the title's own original language.
QUALITY_PREFERRED_LANGUAGES=hun,eng
QUALITY_DEFAULT_LANGUAGE=eng
QUALITY_EXCLUDE_LANGUAGES=
QUALITY_LANGUAGE_BONUS=1000000
# 1 = language beats resolution (720p hun over 1080p eng), 0 = resolution first
QUALITY_LANGUAGE_FIRST=0

# DOCKER
COMPOSE_FILE=.docker/docker-compose.yml
COMPOSE_PROJECT_NAME=aioseerr
