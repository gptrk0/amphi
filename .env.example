# Copy to .env and fill in. The .env is gitignored, this file is not — keep it free of
# secrets.
#
# Everything else the app has — TMDB, the indexers, qBittorrent, the quality profile, the
# scanner, the content check, notifications — is a setting: it lives in the database and
# is edited on the /settings page. There are no API keys or passwords here, and nothing
# below is read anywhere but at startup. A fresh install starts with the defaults from
# src/lib/settings.ts and needs a TMDB API key on that page before it can show anything.

# APP
APP_ENV=development
APP_PORT=3000

# DATABASE
DATABASE_HOST=aioseerr_db
DATABASE_PORT=5432
DATABASE_USER=aioseerr
DATABASE_PASS=
DATABASE_NAME=aioseerr
DATABASE_URL="postgresql://${DATABASE_USER}:${DATABASE_PASS}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=public"

# SCANNER
# 1 = the background scanner does not start at all. Deliberately not a setting: an
# emergency brake must not live somewhere the app can talk itself out of it.
SCAN_DISABLED=0

# DOCKER
COMPOSE_FILE=.docker/docker-compose.yml
COMPOSE_PROJECT_NAME=aioseerr
